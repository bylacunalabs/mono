{
  "name": "mono",
  "private": true,
  "version": "1.0.0",
  "description": "Speed reading, one word at a time: the Mono RSVP reader as a Progressive Web App",
  "license": "MIT",
  "author": "Lacuna Labs",
  "homepage": "https://mono.lacunalabs.it",
  "keywords": [
    "rsvp",
    "speed-reading",
    "reader",
    "pwa",
    "preact"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bylacunalabs/mono.git"
  },
  "bugs": {
    "url": "https://github.com/bylacunalabs/mono/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "brand": "node scripts/brand.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "pdfjs-dist": "^6.5.438",
    "posthog-js": "^1.445.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
